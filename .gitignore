# Authoritative source workbooks (design reference only — NOT committed to git)
# Files in xls/real data/ are the plant's native Excel workbooks used purely as
# the design/source-of-truth reference during development. They are protected
# source data (Master Rules §44) and must never be committed to the repo.
xls/real data/

# Cleaned/consolidated workbooks (design aid only — NOT committed to git)
# xls/consolidated/ holds operator-code-normalized copies built from xls/real data/
# for detailed review. Same rule as above: local design artifact, never in git.
xls/consolidated/

# Legacy DB backups (local only, never commit)
.db_backup_kiln/

# Local archive of superseded prototype CSVs (zipped, not tracked)
xls/archive/
