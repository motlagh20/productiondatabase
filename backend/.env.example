# MES backend — Django + DRF
# Thin vertical slice (F2→F3→F4→F5→F7). See docs/M5_SRS.md, docs/M5_API_CONTRACT.md.

# --- App DB (Django-owned, clean core per ADR-0008) ---
DB_NAME=mes_app
# Pandas-style: the staging postgres exposes host port 5433 on the same machine.
DB_HOST=localhost
# Staging/frozen apps use 5432/3000 — do not collide (ADR-0002).
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=test

# --- Staging (historical source, read-only) ---
STAGING_DB_HOST=localhost
STAGING_DB_PORT=5433
STAGING_DB_NAME=postgres
STAGING_DB_USER=postgres
STAGING_DB_PASSWORD=test

# --- Django ---
SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Frontend dev server origin (Vite) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
